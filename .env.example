# Server-only configuration. Never put secret keys in Flutter assets or Dart defines.
EATME_ENV=development
AUTH_MODE=development
DATABASE_URL=var/eatme-dev.sqlite3
MIGRATION_DATABASE_URL=
# EatMe production Supabase project (the project ref and URL are public).
SUPABASE_PROJECT_REF=ngqetldudwzemdhjprmv
SUPABASE_URL=https://ngqetldudwzemdhjprmv.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGINS=http://localhost:3000
ADMIN_USER_IDS=
EATME_API_URL=http://127.0.0.1:8000/api/v1
RANKING_WEIGHTS_JSON=
# Use development only for explicit fixtures; use openai for live processing.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_MONTHLY_LIMIT=50
MEDIA_DIRECTORY=var/media
# Production API and worker use the same private Supabase Storage bucket.
# Keep filesystem for local development/tests only.
MEDIA_STORAGE_BACKEND=filesystem
SUPABASE_MEDIA_BUCKET=eatme-private-media
MEDIA_ENCRYPTION_KEY=
PRODUCT_CONTACT=
REVENUECAT_SECRET_KEY=
PRIVACY_OPERATOR=
PRIVACY_CONTACT=
GUEST_APP_URL=http://localhost:3000
GUEST_INVITE_EXPIRY_HOURS_AFTER_EVENT=24
GUEST_TEMP_DATA_RETENTION_DAYS=7

# Server-only Sign in with Apple lifecycle keys. Native App ID and Android Services ID.
APPLE_CLIENT_ID=com.filippocinotti.eatme
APPLE_ANDROID_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Optional pre-generated native secret; prefer the signing key for automatic rotation.
APPLE_CLIENT_SECRET=
